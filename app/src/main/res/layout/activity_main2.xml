<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity2">

    <!-- Inspection items: one label + one RadioGroup (Good / Average / Poor) per row -->
    <TableLayout
        android:id="@+id/tableInspection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        android:stretchColumns="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Cargo Floor -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCargoFloor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cargo Floor" />

            <RadioGroup
                android:id="@+id/rgCargoFloor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbCargoFloorGood"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Good" />

                <RadioButton
                    android:id="@+id/rbCargoFloorAverage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Average" />

                <RadioButton
                    android:id="@+id/rbCargoFloorPoor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Poor" />
            </RadioGroup>
        </TableRow>

        <!-- Cargo Ceiling -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCargoCeiling"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cargo Ceiling" />

            <RadioGroup
                android:id="@+id/rgCargoCeiling"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbCargoCeilingGood"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Good" />

                <RadioButton
                    android:id="@+id/rbCargoCeilingAverage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Average" />

                <RadioButton
                    android:id="@+id/rbCargoCeilingPoor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Poor" />
            </RadioGroup>
        </TableRow>

        <!-- Cargo Bulkhead/Sidewalls -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCargoSidewalls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cargo Bulkhead/Sidewalls" />

            <RadioGroup
                android:id="@+id/rgCargoSidewalls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbCargoSidewallsGood"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Good" />

                <RadioButton
                    android:id="@+id/rbCargoSidewallsAverage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Average" />

                <RadioButton
                    android:id="@+id/rbCargoSidewallsPoor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Poor" />
            </RadioGroup>
        </TableRow>

        <!-- Cargo Smoke Detector -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCargoSmokeDetector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cargo Smoke Detector" />

            <RadioGroup
                android:id="@+id/rgCargoSmokeDetector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbCargoSmokeDetectorGood"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Good" />

                <RadioButton
                    android:id="@+id/rbCargoSmokeDetectorAverage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Average" />

                <RadioButton
                    android:id="@+id/rbCargoSmokeDetectorPoor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Poor" />
            </RadioGroup>
        </TableRow>

    </TableLayout>

    <!-- Comments -->
    <TextView
        android:id="@+id/tvCommentsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:text="ENTER PHYSICAL AIRCRAFT COMMENTS"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tableInspection" />

    <EditText
        android:id="@+id/editTextComments"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:gravity="top|start"
        android:hint="Comments"
        android:importantForAutofill="no"
        android:inputType="textMultiLine"
        android:minLines="4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvCommentsLabel" />

    <!-- Navigation -->
    <TextView
        android:id="@+id/textview_first"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/button_first"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/button_first"
        android:layout_width="129dp"
        android:layout_height="48dp"
        android:layout_marginBottom="24dp"
        android:text="@string/save"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>